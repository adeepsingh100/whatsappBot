# --- Database (CockroachDB free tier; the bot uses POSTGRES_USERS_DB too unless DATABASE_URL is set) ---
# Keep "options=-c autocommit_before_ddl=false": without it Evolution Go's WhatsApp-session migrations fail
# on CockroachDB ("pq: unexpected transaction status idle"). Neon/real Postgres: drop the options part.
POSTGRES_AUTH_DB=postgresql://USER:PASSWORD@HOST:26257/evogo_auth?sslmode=verify-full&options=-c%20autocommit_before_ddl%3Dfalse
POSTGRES_USERS_DB=postgresql://USER:PASSWORD@HOST:26257/evogo_users?sslmode=verify-full&options=-c%20autocommit_before_ddl%3Dfalse
# DATABASE_URL=            # bot tables; empty locally = SQLite at data/bot.db

# --- Evolution Go ---
GLOBAL_API_KEY=change-me-long-random       # admin key: manager UI login, /qr?key=...
INSTANCE_TOKEN=change-me-another-random    # bot creates the instance with this token
INSTANCE_NAME=twin
EVOLUTION_OPERATOR_EMAIL=                  # after first manual license activation: auto re-activates headlessly

# --- LLM chain: NVIDIA -> OpenRouter -> Ollama (unset = skipped) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b,openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b   # comma = fallback order
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_URL=                                # e.g. http://localhost:11434 (local testing only)
OLLAMA_MODEL=llama3.1

# --- You ---
MY_NAME=                                   # your name exactly as in chat exports
MY_NUMBER=                                 # your number with country code, e.g. 919811111111 (self-chat detection)
SAFE_MODE=true
